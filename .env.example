# [Optional] Custom WebSocket URL (defaults automatically to same-origin wss://<vercel-host>/api/ws in production)
VITE_WS_URL=

# [Optional] Upstash Redis / Vercel KV for Cross-Instance Sync on Vercel
# Automatically set when you add Upstash Redis from Vercel Marketplace (Storage tab)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local development port (default 5000)
PORT=5000
